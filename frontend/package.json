{
  "name": "2fas-share-frontend",
  "private": true,
  "type": "module",
  "packageManager": "yarn@4.11.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/twofas/2fas-share.git"
  },
  "author": {
    "name": "2FAS",
    "url": "https://github.com/twofas"
  },
  "license": "GPL-3.0",
  "bugs": {
    "url": "https://github.com/twofas/2fas-share/issues"
  },
  "homepage": "https://github.com/twofas/2fas-share#readme",
  "funding": {
    "type": "individual",
    "url": "https://2fas.com/donate/"
  },
  "scripts": {
    "dev": "vite",
    "build": "yarn generate-license-info && vite build",
    "build-ci": "vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "generate-license-info-html": "npx -y license-report --output=html >> open-source-licenses.html",
    "generate-license-info-json": "npx -y license-report --output=json >> open-source-licenses.json",
    "generate-license-info": "yarn generate-license-info-html && yarn generate-license-info-json"
  },
  "dependencies": {
    "canvas-confetti": "^1.9.4",
    "preact": "^10.29.2",
    "qrcode": "^1.5.4",
    "ua-parser-js": "^2.0.10",
    "wouter-preact": "^3.10.0"
  },
  "devDependencies": {
    "@babel/core": "^8.0.1",
    "@eslint/js": "^10.0.1",
    "@preact/preset-vite": "^2.10.5",
    "eslint": "^10.5.0",
    "eslint-plugin-jsdoc": "^63.0.7",
    "globals": "^17.7.0",
    "sass-embedded": "^1.100.0",
    "vite": "^8.0.16",
    "vite-plugin-compression2": "^2.5.3",
    "vite-plugin-svgr": "^5.2.0"
  },
  "resolutions": {
    "postcss": "^8.5.10",
    "picomatch@^2.2.2": "^2.3.2",
    "flatted": "^3.4.2",
    "tar": "^7.5.11"
  }
}
